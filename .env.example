# Base URL of the Harvest backend. This is embedded in the browser bundle,
# so it must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:8080

# OAuth 2.0 Web client ID from the Google Cloud console. Must match the
# backend's GOOGLE_CLIENT_ID exactly. A client ID is public by design.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
